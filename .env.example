# Local development
NODE_ENV=development
PORT=3000

# MySQL connection string.
# Local Homebrew/Docker example:
DATABASE_URL=mysql://root:password@localhost:3306/quickquartz
# Cloud SQL Unix socket example:
# DATABASE_URL=mysql://quickquartz:PASSWORD@localhost/quickquartz?socketPath=/cloudsql/PROJECT_ID:us-central1:quick-quartz-db

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters

# Local onboarding defaults. Disable both in production after the first admin exists.
ALLOW_SIGNUPS=true
ALLOW_FIRST_USER_ADMIN=true
ADMIN_EMAILS=

# Cookies and proxy behavior.
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=1

# Security middleware.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
BODY_LIMIT=1mb
